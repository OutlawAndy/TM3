{
  "name": "tm3",
  "displayName": "TM3",
  "description": "Personal editor extension chassis: grammar tweaks, snippets, commands, and language features.",
  "version": "0.0.8",
  "publisher": "outlawandy",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tm3.macros.toggleRecord",
        "title": "TM3: Toggle Macro Recording",
        "category": "TM3"
      },
      {
        "command": "tm3.macros.replay",
        "title": "TM3: Replay Last Macro",
        "category": "TM3"
      },
      {
        "command": "tm3.macros.saveAs",
        "title": "TM3: Save Current Macro As…",
        "category": "TM3"
      },
      {
        "command": "tm3.macros.loadNamed",
        "title": "TM3: Load Named Macro…",
        "category": "TM3"
      },
      {
        "command": "tm3.ruby.toggleHashSyntax",
        "title": "TM3: Toggle Ruby Hash Syntax",
        "category": "TM3"
      },
      {
        "command": "tm3.ruby.toggleStringSymbol",
        "title": "TM3: Toggle String/Symbol",
        "category": "TM3"
      },
      {
        "command": "tm3.ruby.toggleQuoteStyle",
        "title": "TM3: Toggle Quote Style",
        "category": "TM3"
      },
      {
        "command": "tm3.ruby.toggleCamelSnake",
        "title": "TM3: Toggle camelCase / snake_case",
        "category": "TM3"
      },
      {
        "command": "tm3.ruby.toggleBlockStyle",
        "title": "TM3: Toggle Block Style (do…end / { })",
        "category": "TM3"
      },
      {
        "command": "tm3.ruby.toggleArrayLiteral",
        "title": "TM3: Toggle Array Literal (%i/%w)",
        "category": "TM3"
      },
      {
        "command": "tm3.source.sortCollection",
        "title": "TM3: Sort Collection",
        "category": "TM3"
      },
      {
        "command": "tm3.ascii.toggleBoxDrawing",
        "title": "TM3: Toggle ASCII/Unicode Box Drawing",
        "category": "TM3"
      }
    ],
    "keybindings": [
      {
        "command": "tm3.macros.toggleRecord",
        "key": "cmd+alt+m",
        "when": "editorTextFocus"
      },
      {
        "command": "tm3.macros.replay",
        "key": "cmd+shift+m",
        "when": "editorTextFocus"
      },
      {
        "command": "tm3.ruby.toggleQuoteStyle",
        "key": "ctrl+\"",
        "when": "editorTextFocus && editorLangId == 'ruby'"
      },
      {
        "command": "tm3.ruby.toggleBlockStyle",
        "key": "ctrl+shift+[",
        "when": "editorTextFocus && editorLangId == 'ruby'"
      },
      {
        "command": "tm3.ruby.toggleArrayLiteral",
        "key": "ctrl+cmd+\\",
        "when": "editorTextFocus && editorLangId == 'ruby'"
      },
      {
        "command": "tm3.ascii.toggleBoxDrawing",
        "key": "ctrl+cmd+b",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "editor.action.insertSnippet",
        "key": "space",
        "when": "editorTextFocus && !editorReadonly && editorHasSelection",
        "args": {
          "snippet": "${TM_SELECTED_TEXT/^\\s*([\\s\\S]*?)\\s*$/$1/}"
        }
      },
      {
        "command": "editor.action.insertSnippet",
        "key": "shift+space",
        "when": "editorTextFocus && !editorReadonly && editorHasSelection",
        "args": {
          "snippet": "${TM_SELECTED_TEXT/^\\s*([\\s\\S]*?)\\s*$/ $1/}"
        }
      }
    ],
    "configuration": {
      "title": "TM3",
      "properties": {
        "tm3.greeting": {
          "type": "string",
          "default": "Hello",
          "description": "Greeting used by the TM3: Hello World command."
        },
        "tm3.macros.maxEvents": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "maximum": 100000,
          "description": "Maximum number of recorded events before macro recording auto-stops."
        },
        "tm3.macros.filterMouseSelection": {
          "type": "boolean",
          "default": true,
          "description": "Drop mouse-driven selection changes from macro recordings."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "text.html.markdown.todo.injection",
        "path": "./syntaxes/markdown-todo.injection.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "themes": [
      {
        "label": "Spinel",
        "uiTheme": "vs-dark",
        "path": "./themes/spinel-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "npm run build && vsce package --allow-missing-repository --no-rewrite-relative-links",
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0"
  }
}
