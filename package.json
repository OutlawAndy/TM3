{
  "name": "tm3",
  "displayName": "TM3",
  "description": "Personal editor extension chassis: grammar tweaks, snippets, commands, and language features.",
  "version": "0.0.8",
  "publisher": "outlawandy",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tm3.macros.toggleRecord",
        "title": "TM3: Toggle Macro Recording",
        "category": "TM3"
      },
      {
        "command": "tm3.macros.replay",
        "title": "TM3: Replay Last Macro",
        "category": "TM3"
      },
      {
        "command": "tm3.macros.saveAs",
        "title": "TM3: Save Current Macro As…",
        "category": "TM3"
      },
      {
        "command": "tm3.macros.loadNamed",
        "title": "TM3: Load Named Macro…",
        "category": "TM3"
      },
      {
        "command": "tm3.ruby.toggleHashSyntax",
        "title": "TM3: Toggle Ruby Hash Syntax",
        "category": "TM3"
      },
      {
        "command": "tm3.ruby.toggleStringSymbol",
        "title": "TM3: Toggle String/Symbol",
        "category": "TM3"
      },
      {
        "command": "tm3.ruby.toggleQuoteStyle",
        "title": "TM3: Toggle Quote Style",
        "category": "TM3"
      },
      {
        "command": "tm3.ruby.toggleCamelSnake",
        "title": "TM3: Toggle camelCase / snake_case",
        "category": "TM3"
      },
      {
        "command": "tm3.ruby.toggleBlockStyle",
        "title": "TM3: Toggle Block Style (do…end / { })",
        "category": "TM3"
      },
      {
        "command": "tm3.ruby.toggleArrayLiteral",
        "title": "TM3: Toggle Array Literal (%i/%w)",
        "category": "TM3"
      },
      {
        "command": "tm3.source.sortCollection",
        "title": "TM3: Sort Collection",
        "category": "TM3"
      }
    ],
    "keybindings": [
      {
        "command": "tm3.macros.toggleRecord",
        "key": "cmd+alt+m",
        "when": "editorTextFocus"
      },
      {
        "command": "tm3.macros.replay",
        "key": "cmd+shift+m",
        "when": "editorTextFocus"
      },
      {
        "command": "tm3.ruby.toggleQuoteStyle",
        "key": "ctrl+\"",
        "when": "editorTextFocus && editorLangId == 'ruby'"
      },
      {
        "command": "tm3.ruby.toggleBlockStyle",
        "key": "ctrl+shift+[",
        "when": "editorTextFocus && editorLangId == 'ruby'"
      },
      {
        "command": "tm3.ruby.toggleArrayLiteral",
        "key": "ctrl+cmd+\\",
        "when": "editorTextFocus && editorLangId == 'ruby'"
      },
      {
        "command": "editor.action.insertSnippet",
        "key": "space",
        "when": "editorTextFocus && !editorReadonly && editorHasSelection",
        "args": {
          "snippet": "${TM_SELECTED_TEXT/^\\s*([\\s\\S]*?)\\s*$/$1/}"
        }
      },
      {
        "command": "editor.action.insertSnippet",
        "key": "shift+space",
        "when": "editorTextFocus && !editorReadonly && editorHasSelection",
        "args": {
          "snippet": "${TM_SELECTED_TEXT/^\\s*([\\s\\S]*?)\\s*$/ $1/}"
        }
      }
    ],
    "configuration": {
      "title": "TM3",
      "properties": {
        "tm3.greeting": {
          "type": "string",
          "default": "Hello",
          "description": "Greeting used by the TM3: Hello World command."
        },
        "tm3.macros.maxEvents": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "maximum": 100000,
          "description": "Maximum number of recorded events before macro recording auto-stops."
        },
        "tm3.macros.filterMouseSelection": {
          "type": "boolean",
          "default": true,
          "description": "Drop mouse-driven selection changes from macro recordings."
        },
        "tm3.inline.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Pi-backed Copilot-style inline (ghost-text) suggestions. Requires an Anthropic API key (tm3.inline.apiKey or the ANTHROPIC_API_KEY environment variable)."
        },
        "tm3.inline.model": {
          "type": "string",
          "default": "claude-haiku-4-5",
          "description": "Model id used for inline suggestions. For hosted Anthropic, a pi-ai model id (e.g. claude-haiku-4-5). For a local server (tm3.inline.baseUrl set), the model name your server serves."
        },
        "tm3.inline.baseUrl": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible base URL for a local inference server, e.g. an MLX server at http://localhost:10240/v1. Leave empty to use hosted Anthropic."
        },
        "tm3.inline.contextWindow": {
          "type": "number",
          "default": 8192,
          "minimum": 512,
          "maximum": 1000000,
          "description": "Context window (in tokens) to advertise for a local model. Ignored when using hosted Anthropic."
        },
        "tm3.inline.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "maximum": 5000,
          "description": "Quiet period after the last keystroke before requesting a suggestion."
        },
        "tm3.inline.maxTokens": {
          "type": "number",
          "default": 256,
          "minimum": 16,
          "maximum": 2048,
          "description": "Maximum tokens to generate per inline suggestion."
        },
        "tm3.inline.temperature": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 1,
          "description": "Sampling temperature for inline suggestions. Lower is more deterministic."
        },
        "tm3.inline.maxPrefixChars": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 20000,
          "description": "Characters of context taken from before the cursor."
        },
        "tm3.inline.maxSuffixChars": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "maximum": 20000,
          "description": "Characters of context taken from after the cursor."
        },
        "tm3.inline.apiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key for inline suggestions. Leave empty to use the ANTHROPIC_API_KEY environment variable. Note: stored in plaintext settings."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "text.html.markdown.todo.injection",
        "path": "./syntaxes/markdown-todo.injection.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "themes": [
      {
        "label": "Spinel",
        "uiTheme": "vs-dark",
        "path": "./themes/spinel-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "npm run build && vsce package --allow-missing-repository --no-rewrite-relative-links",
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.2"
  }
}
