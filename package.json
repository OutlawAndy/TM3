{
  "name": "text-mate-3",
  "displayName": "TextMate3",
  "description": "Personal editor extension chassis: grammar tweaks, snippets, commands, and language features.",
  "version": "0.0.1",
  "publisher": "outlawandy",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "textMate3.helloWorld",
        "title": "TextMate3: Hello World",
        "category": "TextMate3"
      }
    ],
    "configuration": {
      "title": "TextMate3",
      "properties": {
        "textMate3.greeting": {
          "type": "string",
          "default": "Hello",
          "description": "Greeting used by the TextMate3: Hello World command."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "text.html.markdown.todo.injection",
        "path": "./syntaxes/markdown-todo.injection.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/example.code-snippets"
      },
      {
        "language": "plaintext",
        "path": "./snippets/example.code-snippets"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "npm run build && vsce package --allow-missing-repository --no-rewrite-relative-links",
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
